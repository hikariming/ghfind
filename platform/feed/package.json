{
  "name": "@ghfind/feed-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capacity:local": "tsc --project tsconfig.capacity.json --noEmit && vitest run --config vitest.capacity.config.ts --update",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.129.0"
  },
  "dependencies": {
    "zod": "4.5.4"
  }
}
