{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "vitest": {
        "entry": [
          "src/**/*.test.{ts,tsx}",
          "packages/**/*.test.{ts,tsx}"
        ]
      },
      "ignore": [
        "packages/ghfind-js/**"
      ]
    },
    "scoring": {
      "entry": [
        "test/**/*.test.ts",
        "tools/*.{ts,mts}"
      ],
      "vitest": {
        "entry": [
          "test/**/*.test.ts"
        ]
      }
    },
    "apps/web": {
      "entry": [
        "src/pages/**/*.astro",
        "src/shims/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/api": {
      "entry": [
        "src/shims/*.ts",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "cloudflare",
        "vercel-og-edge"
      ]
    },
    "apps/coord": {
      "ignoreDependencies": [
        "cloudflare"
      ]
    }
  },
  "ignoreBinaries": [
    "go",
    "gofmt"
  ]
}
