---
/**
 * Global footer (port of the Next `SiteFooter`). Beyond the sponsor credit, it
 * surfaces the trust-anchor pages (About / Contact / Privacy / Methodology) as
 * real internal links on every page.
 */
import { localePath, type Locale } from "@ghfind/i18n";
import type { IslandIntl } from "../islands/IslandRoot";
import { FooterSponsorIsland } from "../islands";
import { getTranslator } from "../lib/i18n";

interface Props {
  locale: Locale;
  intl: IslandIntl;
}

const { locale, intl } = Astro.props;
const REPO_URL = "https://github.com/hikariming/ghfind";
const [t, tNav] = await Promise.all([getTranslator(locale, "footer"), getTranslator(locale, "nav")]);
const href = (p: string) => localePath(locale, p);

const columns = [
  {
    title: t("sectionProduct"),
    links: [
      { label: tNav("leaderboard"), href: href("/leaderboard") },
      { label: tNav("developers"), href: href("/developers") },
      { label: tNav("versus"), href: href("/vs") },
      { label: t("blog"), href: href("/blog") },
    ],
  },
  {
    title: t("sectionResources"),
    links: [
      { label: t("docs"), href: href("/docs") },
      { label: t("methodology"), href: href("/methodology") },
      { label: "API", href: "/openapi.json", rel: "noopener" },
      { label: "llms.txt", href: "/llms.txt", rel: "noopener" },
      { label: t("source"), href: REPO_URL, rel: "noopener", target: "_blank" },
    ],
  },
  {
    title: t("sectionCompany"),
    links: [
      { label: t("about"), href: href("/about") },
      { label: t("contact"), href: href("/contact") },
      { label: t("privacy"), href: href("/privacy") },
    ],
  },
];
---
<footer class="site-footer mt-auto w-full border-t border-[var(--border)] px-5 py-10">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <div class="text-lg font-black text-[var(--foreground)]">ghfind</div>
        <p class="mt-2 text-sm text-zinc-500">{t("tagline")}</p>
      </div>
      {columns.map((col) => (
        <div>
          <div class="text-xs font-semibold uppercase tracking-wide text-zinc-500">{col.title}</div>
          <ul class="mt-3 flex flex-col gap-2 text-sm text-zinc-400">
            {col.links.map((l) => (
              <li><a href={l.href} class="hover:text-[var(--primary)]" rel={l.rel} target={l.target}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="flex justify-center border-t border-[var(--border)] pt-6">
      <FooterSponsorIsland client:idle intl={intl} />
    </div>
  </div>
</footer>
