---
/**
 * Page chrome shared by every migrated page: <head> metadata with the same
 * shape the Next app emits (canonical, hreflang, OG/Twitter from the `meta`
 * namespace, site JSON-LD), the pre-paint theme script, GA, and the
 * workspace shell.
 */
import "../styles/global.css";
import { HTML_LANG, localeAlternates, localeDir, localePath, type Locale } from "@ghfind/i18n";
import { SITE_URL } from "@/lib/site";
import { THEME_INIT_SCRIPT } from "@/lib/theme-init";
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from "@/components/JsonLd";
import { getTranslator } from "../lib/i18n";
import Shell from "../components/Shell.astro";
import JsonLd from "../components/JsonLd.astro";

interface Props {
  locale: Locale;
  /** Locale-agnostic path of this page, e.g. `/about`. */
  path: string;
  title: string;
  description: string;
}

const { locale, path, title, description } = Astro.props;
const t = await getTranslator(locale, "meta");
const alternates = localeAlternates(locale, path);
// Next's metadata resolver renders the root as the bare origin (no trailing
// slash); match it so canonical/og:url stay byte-identical across stacks.
const abs = (p: string) => (p === "/" ? new URL(SITE_URL).origin : new URL(p, SITE_URL).href);
const ogImage = abs("/api/og/home");
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "G-GHXRYBFZEN";
---
<!doctype html>
<html lang={HTML_LANG[locale]} dir={localeDir(locale)} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(alternates.canonical)} />
    {Object.entries(alternates.languages).map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={abs(href)} />
    ))}
    {/* OG/Twitter mirror the Next layout defaults, which pages don't override. */}
    <meta property="og:title" content={t("ogTitle")} />
    <meta property="og:description" content={t("ogDescription")} />
    <meta property="og:url" content={abs(localePath(locale, "/"))} />
    <meta property="og:site_name" content={t("siteName")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("siteName")} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("title")} />
    <meta name="twitter:description" content={t("twDescription")} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
    {/* Body text is the self-hosted DM Sans (@font-face in globals.css,
        served from /fonts). globals.css builds --font-sans/--font-mono on the
        --font-geist-* variables that next/font defines in the Next app; an
        undefined var would invalidate the whole font-family, so define them.
        TODO(P2): self-host Geist Mono before docs/blog (code blocks) move. */}
    <style is:global>
      :root { --font-geist-sans: system-ui; --font-geist-mono: ui-monospace, SFMono-Regular, Menlo, monospace; }
    </style>
  </head>
  <body class="min-h-full flex flex-col">
    <JsonLd data={websiteJsonLd({ name: t("siteName"), description: t("description") })} />
    <JsonLd data={organizationJsonLd(t("siteName"))} />
    <JsonLd data={softwareApplicationJsonLd({ name: t("siteName"), description: t("description") })} />
    <Shell locale={locale} path={path}>
      <slot />
    </Shell>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    {/* navigator.webdriver flags headless automation (scraper farms were
        inflating GA4 pageviews) — skip config so no hit is ever sent. */}
    <script is:inline set:html={`if (!navigator.webdriver) { window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${GA_MEASUREMENT_ID}'); }`} />
  </body>
</html>
