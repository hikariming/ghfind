---
import Base from "../../../../layouts/Base.astro";
import { DeveloperFacetIsland } from "../../../../islands/DeveloperFacetIsland";
import { getMessages, getTranslator, pickMessages, routeLocale } from "../../../../lib/i18n";
import { notFound } from "../../../../lib/not-found";
import {
  bucketHeadingKey,
  facetEncodedPath,
  facetValueFromSegments,
  loadDeveloperFacet,
  parseFacetType,
} from "@/lib/pages/developer-facet";

const locale = routeLocale(Astro.params.locale);
const type = parseFacetType(Astro.params.type ?? "");
// Raw (still-encoded) segments, like Next's catch-all params: Astro's decoded
// rest param would be decoded twice by facetValueFromSegments.
const raw = Astro.url.pathname.match(/\/developers\/[^/]+\/(.+)$/)?.[1];
const value = facetValueFromSegments(raw?.split("/"));
if (!locale || !type || !value) return notFound();
const [t, tMeta, messages, data] = await Promise.all([
  getTranslator(locale, "developers"),
  getTranslator(locale, "meta"),
  getMessages(locale),
  loadDeveloperFacet(type, value),
]);
if (!data) return notFound();
const path = `/developers/${type}/${facetEncodedPath(value)}`;
const heading = t(bucketHeadingKey(type), { value });
Astro.response.headers.set("Cache-Control", "private, no-cache, no-store, max-age=0, must-revalidate");
---
<Base locale={locale} path={path} title={`${heading} · ${tMeta("siteName")}`} description={t("bucketMetaDescription", { value })}>
  <DeveloperFacetIsland
    client:load
    locale={locale}
    type={type}
    value={value}
    {...data}
    intl={{ locale, pathname: path, search: Astro.url.search, messages: pickMessages(messages, ["developers", "leaderboard", "tiers", "projectBoards", "discoveryNext"]) }}
  />
</Base>
