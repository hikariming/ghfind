---
import Base from "../../layouts/Base.astro";
import { Methodology } from "../../views";
import { getTranslator, routeLocale } from "../../lib/i18n";
import { STATIC_PAGE_CACHE } from "../../lib/not-found";

const locale = routeLocale(Astro.params.locale);
if (!locale) return new Response(null, { status: 404 });

const [t, tDim] = await Promise.all([getTranslator(locale, "methodology"), getTranslator(locale, "dimensions")]);
Astro.response.headers.set("Cache-Control", STATIC_PAGE_CACHE);
---
<Base locale={locale} path="/methodology" title={t("metaTitle")} description={t("metaDescription")}>
  <Methodology route={{ locale, path: "/methodology" }} t={t} tDim={tDim} />
</Base>
