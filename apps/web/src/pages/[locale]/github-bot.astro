---
import Base from "../../layouts/Base.astro";
import { GithubBot } from "../../views";
import { getTranslator, routeLocale } from "../../lib/i18n";
import { STATIC_PAGE_CACHE } from "../../lib/not-found";

const locale = routeLocale(Astro.params.locale);
if (!locale) return new Response(null, { status: 404 });

const [t] = await Promise.all([getTranslator(locale, "githubBot")]);
Astro.response.headers.set("Cache-Control", STATIC_PAGE_CACHE);
---
<Base locale={locale} path="/github-bot" title={t("metaTitle")} description={t("metaDescription")}>
  <GithubBot route={{ locale, path: "/github-bot" }} locale={locale} t={t} />
</Base>
