{
  "$comment": "Open-core split map (docs/architecture/open-core-split.md). Rules are ordered; the first matching glob wins. Every tracked file must match exactly one rule (CI: node ops/open-core/split.mjs check). side = public (stays in the open-source repo), private (moves to the private backend repo), both (seeded into both, then each repo edits its own copy).",
  "publicRepository": "hikariming/ghfind",
  "privateRepository": "<org>/ghfind-backend",
  "rules": [
    {
      "glob": "scoring/**",
      "side": "public",
      "module": "scoring",
      "why": "Deterministic rubric: RawMetrics contract, evidence->metrics derivation, score, risk, rating ladder, parity fixtures."
    },
    {
      "glob": ".github/workflows/scoring.yml",
      "side": "public",
      "module": "scoring"
    },
    {
      "glob": ".github/workflows/scoring-release.yml",
      "side": "public",
      "module": "scoring"
    },
    {
      "glob": "scripts/check-scoring-boundary.mjs",
      "side": "public",
      "module": "scoring"
    },
    {
      "glob": "docs/scoring/**",
      "side": "public",
      "module": "scoring"
    },
    {
      "glob": "docs/rfc/2026-10-15-account-scoring.md",
      "side": "public",
      "module": "scoring"
    },
    {
      "glob": "packages/ghfind-py/**",
      "side": "public",
      "module": "sdk",
      "why": "Published SDK and Python scoring port. Local crawling is deprecated in the next major (verify-only)."
    },
    {
      "glob": "packages/ghfind-js/**",
      "side": "public",
      "module": "sdk",
      "why": "Published SDK. Verify-only since 0.2.0: ghfind/local bundles @ghfind/scoring and never crawls GitHub."
    },
    {
      "glob": "cmd/ghfind/**",
      "side": "public",
      "module": "sdk",
      "why": "Go CLI; remote API client only (go list -deps has no backend packages)."
    },
    {
      "glob": "internal/agentcli/**",
      "side": "public",
      "module": "sdk"
    },
    {
      "glob": "skills/ghfind-score/**",
      "side": "public",
      "module": "sdk"
    },
    {
      "glob": "skills/ghfind-cli/**",
      "side": "public",
      "module": "sdk"
    },
    {
      "glob": "tests/fixtures/cli/**",
      "side": "both",
      "module": "sdk",
      "why": "CLI version-compare fixture shared by the Go CLI, the JS SDK and the site."
    },
    {
      "glob": "packages/i18n/**",
      "side": "both",
      "module": "frontend",
      "why": "Locale config shared by every frontend; seed of the public frontend module."
    },
    {
      "glob": "show_img/**",
      "side": "public",
      "module": "docs"
    },
    {
      "glob": "docs/architecture/**",
      "side": "both",
      "module": "docs"
    },
    {
      "glob": "docs/README.md",
      "side": "both",
      "module": "docs",
      "why": "Docs index; each repo trims it to the documents it keeps."
    },
    {
      "glob": "docs/development/cli.md",
      "side": "public",
      "module": "sdk",
      "why": "Documents the public Go CLI (cmd/ghfind)."
    },
    {
      "glob": "ops/open-core/**",
      "side": "both",
      "module": "docs"
    },
    {
      "glob": "LICENSE",
      "side": "both",
      "module": "repo",
      "why": "Code moved to the private repo was released under AGPL-3.0; see the licensing section of the architecture doc before changing it."
    },
    {
      "glob": "README.md",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "README.zh.md",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "CONTRIBUTING.md",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "AGENTS.md",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "CLAUDE.md",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": ".gitignore",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": ".github/CODEOWNERS",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "go.mod",
      "side": "both",
      "module": "repo",
      "why": "Public keeps the CLI module; private keeps the backend module and requires scoring by version."
    },
    {
      "glob": "go.sum",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "Makefile",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "package.json",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "pnpm-lock.yaml",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "pnpm-workspace.yaml",
      "side": "both",
      "module": "repo"
    },
    {
      "glob": "src/**",
      "side": "private",
      "module": "backend+frontend",
      "why": "Next app: pages, /api/*, GitHub collector and token pool (src/lib/github.ts), Redis traffic control, DB. Frontend extraction to a public ui/ package is phase 2."
    },
    {
      "glob": "apps/**",
      "side": "private",
      "module": "backend+frontend"
    },
    {
      "glob": "platform/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "internal/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "cmd/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "migrations/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "migrations-feed/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "ops/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "config/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "scripts/**",
      "side": "private",
      "module": "backend",
      "why": "Includes fixture recording (needs live GitHub tokens) and every release/operator script."
    },
    {
      "glob": "tests/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "public/**",
      "side": "private",
      "module": "frontend"
    },
    {
      "glob": "content/**",
      "side": "private",
      "module": "frontend"
    },
    {
      "glob": "design/**",
      "side": "private",
      "module": "frontend"
    },
    {
      "glob": "outputs/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "skills/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": "docs/**",
      "side": "private",
      "module": "backend"
    },
    {
      "glob": ".github/**",
      "side": "private",
      "module": "backend",
      "why": "Deploy, feed and release workflows plus their evidence; they hold production credentials."
    },
    {
      "glob": "*",
      "side": "private",
      "module": "backend",
      "why": "Root build, deploy and runtime config (wrangler, next, Docker, railway, env example, lint/test config)."
    }
  ]
}
