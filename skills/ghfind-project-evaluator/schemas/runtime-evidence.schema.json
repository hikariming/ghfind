{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ghfind.project-analysis.v3"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "repo_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140
    },
    "resolved_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "entries": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "metadata",
              "source",
              "documentation",
              "command",
              "build",
              "test",
              "runtime",
              "external"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "partial",
              "unknown"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "exit_code": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "kind",
          "summary",
          "outcome"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "repo_key",
    "resolved_commit_sha",
    "entries"
  ],
  "additionalProperties": false
}
