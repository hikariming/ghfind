# Local `pnpm dev` uses emulated D1 and does not need Cloudflare credentials.
# TURSO_DATABASE_URL is an optional libSQL fallback outside the local Worker runtime.
# Set TURSO_AUTH_TOKEN only if that database requires authentication.
# Add LLM_API_KEY for operator-funded roast text; deterministic scoring needs no LLM.
# Other groups configure optional features or production services.
# See README.md#local-development for the local database setup.

# ── GitHub data (required) ────────────────────────────────────────────────
# A read-only PAT (classic: public_repo / no scopes needed for public data, or a
# fine-grained token with public read). Lifts rate limits from 60/h to 5000/h and
# enables the GraphQL contribution queries.
# Pool: pass MULTIPLE comma-separated PATs to multiply the ceiling — requests
# round-robin across them and fail over to the next token on rate-limit/5xx.
#   GITHUB_TOKEN=ghp_aaa,ghp_bbb,ghp_ccc
GITHUB_TOKEN=ghp_xxx

# ── Mosoo project evaluation Agent ────────────────────────────────────────
# Server-side credentials for asynchronous public-repository evaluation.
MOSOO_API_BASE=https://try.mosoo.ai/api/v1
MOSOO_API_TOKEN=
MOSOO_PROJECT_AGENT_ID=01KXZBBD8VW1S3AF6GB5EEG13G
MOSOO_PROJECT_REQUEST_TIMEOUT_MS=15000
PROJECT_ANALYSIS_TIMEOUT_MS=900000
PROJECT_ANALYSIS_MAX_CONCURRENCY=20
# Thread creation retries use exponential backoff and release their concurrency slot.
PROJECT_ANALYSIS_CREATE_MAX_ATTEMPTS=3
PROJECT_ANALYSIS_CREATE_RETRY_BASE_MS=5000
# Comma-separated lowercase owner/repo values allowed to execute repository code.
# Every other public repository is limited to source inspection.
PROJECT_ANALYSIS_RUNTIME_ALLOWLIST=
# Bearer or x-reconcile-secret value for the scheduled reconciliation endpoint.
PROJECT_ANALYSIS_RECONCILE_SECRET=

# ── Default LLM (operator-funded; StepFun 阶跃星辰 by default) ─────────────
# OpenAI-compatible. The operator key so visitors don't need their own; when this
# balance/quota is exhausted, the app prompts users to bring their own key.
# Default base = https://api.stepfun.com/v1, default model = step-3.7-flash.
LLM_API_KEY=
LLM_MODEL=step-3.7-flash
# LLM_BASE_URL=https://api.stepfun.com/v1     # override for OpenAI/OpenRouter/Groq/etc
#
# Other OpenAI-compatible providers — just point the three vars at them, e.g.:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile

# ── Fallback LLM (operator-funded; DeepSeek by default) ───────────────────
# Used only on the default path: when the primary provider drops/queues the
# connection or rate-limits BEFORE any answer text streams, the roast fails over
# to this provider instead of erroring (BYO-key requests never fail over).
# Set the key to enable; base URL + model default to DeepSeek deepseek-v4-flash
# (fast — also dodges the primary reasoning model's long chain-of-thought latency).
LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com       # default; override for another provider
# LLM_FALLBACK_MODEL=deepseek-v4-flash                  # default

# ── Cache + rate limiting (required for production cost protection) ────────
# Upstash Redis (free tier). Caches scans 24h by username and rate-limits per IP.
# It is optional in local development. In production, protected uncached routes
# return 503 when Redis is unavailable instead of silently spending GitHub/Turso/LLM budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Emergency operator override only. Leave unset in normal production operation.
# RATE_LIMIT_FAIL_OPEN=1

# ── Human verification (optional but recommended in prod) ─────────────────
# Cloudflare Turnstile (free). If absent, the human-check is skipped. When set,
# successful browser scans also receive a short-lived signed anonymous session
# cookie for per-browser event rate limits behind shared Wi-Fi/NAT.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Local database (required for local scanning) ────────────────────────
# Production uses the Cloudflare D1 binding GHFIND_D1 from wrangler.jsonc.
# TURSO_* is retained for local development and compatibility with maintenance
# scripts; do not use it as a replacement for the production D1 binding.
#   Local:  TURSO_DATABASE_URL=http://127.0.0.1:8080 (no auth token by default)
# The app uses @libsql/client/web, which cannot open file: URLs.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Personalized project Feed (Cloudflare D1) ─────────────────────────────
# Feed is served by the same Cloudflare Worker but has its own GHFIND_FEED_D1
# binding. It has no Railway/Vercel service, Postgres, Redis cursor store, or
# separate signing key: AUTH_SECRET signs Feed cursors and impression tokens.
# Leave unset (or set baseline) to serve the D1 tag-and-quality baseline.
# Set off for an immediate serving kill switch; profile deletion remains
# available so data-removal requests are never blocked by the switch.
FEED_MODE=baseline
# Distinct Worker secret for internal reconciliation and tag review. Never
# expose this value to a browser or put it in NEXT_PUBLIC_*.
FEED_ADMIN_SECRET=

# ── Cloudflare Worker runtime ──────────────────────────────────────────────
# The frontend and backend execute in the same OpenNext Worker. Production
# secrets are set with `wrangler secret put --env production`; do not commit
# secret values or put them in NEXT_PUBLIC_* variables. D1 and R2 are bindings
# managed in wrangler.jsonc. Upstash remains an external Redis REST service for
# cache, coalescing, locks, and rate limits.
# GHFIND_DEPLOY_ENV is supplied by wrangler.jsonc per environment.
# Optional non-secret kill switch for hiding the GitHub login UI.
# GHFIND_OAUTH_ENABLED=0

# ── Admin endpoints (optional) ────────────────────────────────────────────
# Secret for the profile backfill endpoint (POST /api/admin/backfill-profiles
# with header `x-admin-secret`). No default → the endpoint is inert until set.
ADMIN_SECRET=

# Public origin (used for metadata, API profile URLs, share links, and provider
# attribution). Cloudflare production requires both values to be identical HTTPS
# origins; the default production origin is https://ghfind.com.
NEXT_PUBLIC_SITE_URL=https://ghfind.com
PUBLIC_SITE_URL=https://ghfind.com

# ── 用户登录 / GitHub OAuth (Worker server-side; optional) ─────────────────
# Lets visitors "Login with GitHub" (identity only for now). If these are
# absent, the login entry is hidden and everything else works unchanged.
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL              = https://ghfind.com
#   Authorization callback URL = https://ghfind.com/api/auth/callback/github
#   For local app dev, add another or use http://localhost:3000/api/auth/callback/github
# Store these as Worker secrets in production; never expose them through
# NEXT_PUBLIC_* variables.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Session signing secret. Generate: openssl rand -base64 33   (or: npx auth secret)
AUTH_SECRET=
# Set to true only if login callbacks require explicit host trust.
# AUTH_TRUST_HOST=true
