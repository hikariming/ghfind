# ── GitHub data (required) ────────────────────────────────────────────────
# A read-only PAT (classic: public_repo / no scopes needed for public data, or a
# fine-grained token with public read). Lifts rate limits from 60/h to 5000/h and
# enables the GraphQL contribution queries.
# Pool: pass MULTIPLE comma-separated PATs to multiply the ceiling — requests
# round-robin across them and fail over to the next token on rate-limit/5xx.
#   GITHUB_TOKEN=ghp_aaa,ghp_bbb,ghp_ccc
GITHUB_TOKEN=ghp_xxx

# ── Mosoo project evaluation Agent ────────────────────────────────────────
# Server-side credentials for asynchronous public-repository evaluation.
MOSOO_API_BASE=https://try.mosoo.ai/api/v1
MOSOO_API_TOKEN=
MOSOO_PROJECT_AGENT_ID=01KXZBBD8VW1S3AF6GB5EEG13G
MOSOO_PROJECT_REQUEST_TIMEOUT_MS=15000
PROJECT_ANALYSIS_TIMEOUT_MS=900000
PROJECT_ANALYSIS_MAX_CONCURRENCY=3
# The Go worker reads GHFIND_PROJECT_ANALYSIS_CONCURRENCY first and falls back
# to PROJECT_ANALYSIS_MAX_CONCURRENCY above; both clamp to [1,20].
# GHFIND_PROJECT_ANALYSIS_CONCURRENCY=3
# Thread creation retries use exponential backoff and release their concurrency slot.
PROJECT_ANALYSIS_CREATE_MAX_ATTEMPTS=3
PROJECT_ANALYSIS_CREATE_RETRY_BASE_MS=5000
# Comma-separated lowercase owner/repo values allowed to execute repository code.
# Every other public repository is limited to source inspection.
PROJECT_ANALYSIS_RUNTIME_ALLOWLIST=
# Bearer or x-reconcile-secret value for the scheduled reconciliation endpoint.
PROJECT_ANALYSIS_RECONCILE_SECRET=

# ── Default LLM (operator-funded; StepFun 阶跃星辰 by default) ─────────────
# OpenAI-compatible. The operator key so visitors don't need their own; when this
# balance/quota is exhausted, the app prompts users to bring their own key.
# Default base = https://api.stepfun.com/v1, default model = step-3.7-flash.
LLM_API_KEY=
LLM_MODEL=step-3.7-flash
# LLM_BASE_URL=https://api.stepfun.com/v1     # override for OpenAI/OpenRouter/Groq/etc
#
# Other OpenAI-compatible providers — just point the three vars at them, e.g.:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile

# ── Fallback LLM (operator-funded; DeepSeek by default) ───────────────────
# Used only on the default path: when the primary provider drops/queues the
# connection or rate-limits BEFORE any answer text streams, the roast fails over
# to this provider instead of erroring (BYO-key requests never fail over).
# Set the key to enable; base URL + model default to DeepSeek deepseek-v4-flash
# (fast — also dodges the primary reasoning model's long chain-of-thought latency).
LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com       # default; override for another provider
# LLM_FALLBACK_MODEL=deepseek-v4-flash                  # default

# ── Cache + rate limiting (required for production cost protection) ────────
# Upstash Redis (free tier). Caches scans 24h by username and rate-limits per IP.
# It is optional in local development. In production, protected uncached routes
# return 503 when Redis is unavailable instead of silently spending GitHub/Turso/LLM budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Emergency operator override only. Leave unset in normal production operation.
# RATE_LIMIT_FAIL_OPEN=1

# ── Human verification (optional but recommended in prod) ─────────────────
# Cloudflare Turnstile (free). If absent, the human-check is skipped. When set,
# successful browser scans also receive a short-lived signed anonymous session
# cookie for per-browser event rate limits behind shared Wi-Fi/NAT.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Leaderboard + percentile (optional) ───────────────────────────────────
# Turso / libSQL. Stores account scores plus project analysis jobs, assessments,
# treasure history and boards. Project-analysis writes fail loudly when absent.
#   Cloud:  turso db create github-roast && turso db tokens create github-roast
#   Local:  TURSO_DATABASE_URL=file:./local.db   (no auth token needed)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Go API + worker (server-side; follow each variable's placement note) ─────
# The Go API and Go worker reuse the Turso/Upstash resources above without any
# migration. RabbitMQ is the durable task broker for work that must outlive an
# HTTP request. The Go worker also receives GITHUB_TOKEN; the Go API and Vercel
# must not. Use `amqps://` with a managed broker in production.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Job state is stored under `ghfind:backend:job-status:v1:*` in the existing
# Upstash instance and expires after seven days. e.g. 24h, 168h.
# GHFIND_JOB_STATUS_TTL=168h
# GHFIND_JOB_MAX_ATTEMPTS=5
# Scan jobs are latency-bound on sequential GitHub API calls; the worker
# processes this many deliveries in parallel. Unset = auto-sized from the
# GITHUB_TOKEN pool: 8 in-flight scans for one PAT, +4 per additional PAT,
# capped at 20 — adding PATs raises throughput with no other change. The
# sustained ceiling is GitHub's per-token quota (~8-11 API calls per scan,
# 5000/h GraphQL), not the broker or the worker; add worker replicas
# (competing consumers) beyond that.
# GHFIND_SCAN_WORKER_CONCURRENCY=8
# Go listener for local compose/VPS. Railway's injected PORT is honored when
# this is unset.
# GHFIND_API_LISTEN_ADDR=:8080
# Trust Vercel's platform client-IP header for Go-side rate limits. Enable only
# when direct API ingress is restricted to Vercel/ops traffic; otherwise the Go
# API falls back to the non-spoofable socket RemoteAddr.
# GHFIND_TRUST_VERCEL_HEADERS=1
# Worker metrics listener. Expose only to Railway private networking,
# Prometheus, or an SSH tunnel; browsers and Vercel do not need it.
# GHFIND_WORKER_METRICS_LISTEN_ADDR=:9090

# Set only in the Vercel server environment after the Go API is deployed. This
# preserves https://ghfind.com/api/* through a transparent rewrite. Do not set
# it to a public browser variable and do not append a path.
# GHFIND_BACKEND_ORIGIN=https://api-staging.example.com
# Optional non-secret kill switch for hiding GitHub login UI while the Go OAuth
# endpoint is being repaired. Do not configure OAuth client secrets in Vercel.
# GHFIND_OAUTH_ENABLED=0

# Required only once POST /api/vs-verdict is migrated. Set the same random
# value in the Go API and Vercel *server* environment (never NEXT_PUBLIC_*).
# It authenticates the small BotID verification gateway to the private Go
# endpoint; do not give it to the worker or a browser.
# GHFIND_VERDICT_GATEWAY_SECRET=

# ── Admin endpoints (optional) ────────────────────────────────────────────
# Secret for the profile backfill endpoint (POST /api/admin/backfill-profiles
# with header `x-admin-secret`). No default → the endpoint is inert until set.
ADMIN_SECRET=

# Public origin (used for metadata, API profile URLs, share links, and provider
# attribution). Vercel Production requires both values to be identical HTTPS
# origins; the default production origin is https://ghfind.com.
NEXT_PUBLIC_SITE_URL=https://ghfind.com
PUBLIC_SITE_URL=https://ghfind.com

# ── 用户登录 / GitHub OAuth (Go API only; optional) ───────────────────────
# Lets visitors "Login with GitHub" (identity only for now). If these are
# absent, the login entry is hidden and everything else works unchanged.
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL              = https://ghfind.com
#   Authorization callback URL = https://ghfind.com/api/auth/callback/github
#   For local Go API dev, add another or use http://localhost:8080/api/auth/callback/github
# Store these only in the Go API service. Vercel only needs GHFIND_BACKEND_ORIGIN
# so /api/auth/* is transparently rewritten to Go.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Session signing secret. Generate: openssl rand -base64 33   (or: npx auth secret)
AUTH_SECRET=
# Usually auto-trusted on Vercel; set to true only if login callbacks misbehave.
# AUTH_TRUST_HOST=true

# ── Railway staging 一键部署（scripts/deploy-staging.sh）──────────────────
# 以下变量只经环境变量传给脚本，绝不写入文件/仓库。填好后：
#   set -a && source .env.staging && set +a && ./scripts/deploy-staging.sh
#
# Railway 项目名（不存在则创建）
# GHFIND_STAGING_PROJECT=ghfind-staging
# 前端站点 origin（api 的 PUBLIC_SITE_URL 必须与其一致）
# GHFIND_STAGING_SITE_URL=https://staging.ghfind.com
# StepFun（或任意 OpenAI 兼容）LLM key —— roast 文案生成
# GHFIND_STAGING_LLM_KEY=
# GitHub PAT，可逗号分隔多个组成轮转池（worker 采集；并发随 token 数自动放大）
# GHFIND_STAGING_GITHUB_TOKEN=
# Mosoo 项目评测（可留空跳过：提交会排队并以标准 mosoo_* 错误失败）
# GHFIND_STAGING_MOSOO_TOKEN=
# GHFIND_STAGING_MOSOO_AGENT_ID=
# GHFIND_STAGING_MOSOO_USER_ID=ghfind
# GHFIND_STAGING_MOSOO_API_BASE=https://try.mosoo.ai/api/v1
#
# 生产存储模式（可选）：设置后 api/worker 直连真实 Turso/Upstash 并跳过
# mocks/libsql 服务；留空则使用项目内 mock 存储（默认，绝不触碰生产数据）
# GHFIND_STAGING_TURSO_URL=libsql://<db>-<org>.turso.io
# GHFIND_STAGING_TURSO_TOKEN=
# GHFIND_STAGING_UPSTASH_URL=https://<db>.upstash.io
# GHFIND_STAGING_UPSTASH_TOKEN=
