{
  // ghfind frontend + backend on one Cloudflare Worker via @opennextjs/cloudflare.
  // Top level = local `wrangler dev`. Deployments always use --env:
  //   wrangler deploy --env dev         → ghfind-dev (behind ghfind-router-dev on dev.ghfind.com)
  //   wrangler deploy --env production  → ghfind.com
  //   wrangler deploy --env preview --name ghfind-pr-<n> → per-PR preview
  //     (GitHub Actions deploy-cf-preview.yml; no custom routes, workers.dev only)
  // Preflight the target account and verify the D1/R2 resources before deploying.
  // The legacy core D1 is shared by dev/production; Feed uses the separate,
  // dedicated D1 binding below so recommendation reads/writes cannot consume
  // scoring or project-evaluation capacity.
  // Production of record: Beiming1201@gmail.com's Account. Keep this pinned so
  // a local OAuth context with multiple accounts cannot publish to the wrong one.
  // Secrets (TURSO_*, UPSTASH_*, GHFIND_*, TURNSTILE_SECRET_KEY, LLM_*) are set
  // per-env via `wrangler secret put <NAME> --env <env>`, never in this file.
  "name": "ghfind",
  "account_id": "8f19bebe359e4ec1a24c68c5f49c1584",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Local dev (`next dev` / `wrangler dev`) always uses local D1 emulation.
  // Cloudflare credentials and remote databases are never required to start.
  "d1_databases": [
    { "binding": "GHFIND_D1", "database_name": "ghfind", "database_id": "60d45096-bfe7-4de1-8b85-c1b66a466b0d", "migrations_dir": "migrations" },
    { "binding": "GHFIND_FEED_D1", "database_name": "ghfind-feed-dev", "database_id": "bd305af9-2cab-4fe8-8c2f-324391cf105e", "migrations_dir": "migrations-feed" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ghfind-next-cache" }
  ],
  "vars": {
    "GHFIND_DEPLOY_ENV": "development"
  },
  "env": {
    "dev": {
      "name": "ghfind-dev",
      // workers.dev stays on for dev: a WAF-free test entrance (the zone's ASN
      // challenge blocks curl-based smoke from proxy egress IPs).
      "workers_dev": true,
      // No custom domain: dev.ghfind.com belongs to ghfind-router-dev
      // (apps/router), which forwards unmigrated paths here over a service
      // binding. Do NOT re-add the route — a non-interactive deploy would
      // silently take the domain back from the router.
      "d1_databases": [
        { "binding": "GHFIND_D1", "database_name": "ghfind", "database_id": "60d45096-bfe7-4de1-8b85-c1b66a466b0d", "migrations_dir": "migrations" },
        { "binding": "GHFIND_FEED_D1", "database_name": "ghfind-feed-dev", "database_id": "bd305af9-2cab-4fe8-8c2f-324391cf105e", "migrations_dir": "migrations-feed" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ghfind-next-cache-dev" }
      ],
      // Public read-model caches (src/lib/cache-store.ts). Must match
      // ghfind-api's binding/backend so clears on either side hit both.
      "kv_namespaces": [
        { "binding": "GHFIND_CACHE", "id": "d66443adfd3f4fccbab02fcb41e63284" }
      ],
      // Rate limiting on the RateLimiter Durable Object in ghfind-coord-dev
      // (src/lib/rate-limit-backend.ts); same binding as ghfind-api-dev.
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "ghfind-coord-dev" },
          { "name": "COORD_KV", "class_name": "KeyValue", "script_name": "ghfind-coord-dev" },
          { "name": "SCAN_SLOT", "class_name": "ScanSlot", "script_name": "ghfind-coord-dev" }
        ]
      },
      "vars": {
        "GHFIND_DEPLOY_ENV": "preview",
        "GHFIND_CACHE_BACKEND": "kv",
        "GHFIND_RATELIMIT_BACKEND": "do",
        "GHFIND_COORD_BACKEND": "do",
        // Explicit: OpenNext bakes .env values (localhost) into the bundle as
        // fallbacks; bindings must win for anything origin-derived.
        "PUBLIC_SITE_URL": "https://dev.ghfind.com",
        "NEXT_PUBLIC_SITE_URL": "https://dev.ghfind.com"
      }
    },
    "production": {
      "name": "ghfind",
      // workers.dev is a WAF-free verification entrance (zone rules only apply
      // to the custom domain); disable it once the parallel-run window closes.
      "workers_dev": true,
      "routes": [
        { "pattern": "ghfind.com", "custom_domain": true }
      ],
      "d1_databases": [
        { "binding": "GHFIND_D1", "database_name": "ghfind", "database_id": "60d45096-bfe7-4de1-8b85-c1b66a466b0d", "migrations_dir": "migrations" },
        { "binding": "GHFIND_FEED_D1", "database_name": "ghfind-feed", "database_id": "9c4ac13a-4c90-40a8-9d56-d7141f864bbf", "migrations_dir": "migrations-feed" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ghfind-next-cache" }
      ],
      // Upstash replacements (same as scripts/feed-production-release.mjs renderWeb).
      "kv_namespaces": [
        { "binding": "GHFIND_CACHE", "id": "f7a7299eef224d899c21121c1979be32" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "ghfind-coord" },
          { "name": "COORD_KV", "class_name": "KeyValue", "script_name": "ghfind-coord" },
          { "name": "SCAN_SLOT", "class_name": "ScanSlot", "script_name": "ghfind-coord" }
        ]
      },
      "vars": {
        "GHFIND_DEPLOY_ENV": "production",
        "GHFIND_CACHE_BACKEND": "kv",
        "GHFIND_RATELIMIT_BACKEND": "do",
        "GHFIND_COORD_BACKEND": "do",
        // site.ts fails closed in production unless both are set and equal.
        "PUBLIC_SITE_URL": "https://ghfind.com",
        "NEXT_PUBLIC_SITE_URL": "https://ghfind.com"
      }
    },
    "preview": {
      // Per-PR workers deployed by deploy-cf-preview.yml with
      // `--name ghfind-pr-<n>`; no name/routes here so the flag is authoritative.
      // Shares the dev D1 database and dev R2 cache bucket; PUBLIC_SITE_URL /
      // NEXT_PUBLIC_SITE_URL are injected per-PR at build and via `--var`.
      "workers_dev": true,
      "d1_databases": [
        { "binding": "GHFIND_D1", "database_name": "ghfind", "database_id": "60d45096-bfe7-4de1-8b85-c1b66a466b0d", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ghfind-next-cache-dev" }
      ],
      // Public read-model caches (src/lib/cache-store.ts). Must match
      // ghfind-api's binding/backend so clears on either side hit both.
      "kv_namespaces": [
        { "binding": "GHFIND_CACHE", "id": "d66443adfd3f4fccbab02fcb41e63284" }
      ],
      // Rate limiting on the RateLimiter Durable Object in ghfind-coord-dev
      // (src/lib/rate-limit-backend.ts); same binding as ghfind-api-dev.
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "ghfind-coord-dev" },
          { "name": "COORD_KV", "class_name": "KeyValue", "script_name": "ghfind-coord-dev" },
          { "name": "SCAN_SLOT", "class_name": "ScanSlot", "script_name": "ghfind-coord-dev" }
        ]
      },
      "vars": {
        "GHFIND_DEPLOY_ENV": "preview",
        "GHFIND_CACHE_BACKEND": "kv",
        "GHFIND_RATELIMIT_BACKEND": "do",
        "GHFIND_COORD_BACKEND": "do"
      }
    }
  }
}
